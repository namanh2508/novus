# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text file types
*.py text diff=python eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.editorconfig text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pyc binary
