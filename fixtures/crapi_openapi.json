{
  "openapi": "3.0.0",
  "info": {
    "title": "OWASP crAPI API Specification",
    "version": "1.0.0",
    "description": "OWASP completely ridiculous API OpenAPI 3.0 specification for benchmark testing"
  },
  "servers": [
    {
      "url": "http://localhost:8888"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/identity/api/auth/v1/health": {
      "get": {
        "summary": "Healthcheck endpoint",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/identity/api/auth/v1/login": {
      "post": {
        "summary": "User authentication",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful, returns JWT"
          }
        }
      }
    },
    "/identity/api/v2/vehicle/{vehicle_id}/location": {
      "get": {
        "summary": "Get vehicle location coordinates",
        "operationId": "getVehicleLocation",
        "parameters": [
          {
            "name": "vehicle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID of the vehicle"
          }
        ],
        "responses": {
          "200": {
            "description": "Location telemetry returned"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/workshop/api/shop/orders/{order_id}": {
      "get": {
        "summary": "Get order details",
        "operationId": "getOrderDetails",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier of order"
          }
        ],
        "responses": {
          "200": {
            "description": "Order details returned"
          }
        }
      }
    },
    "/community/api/v2/coupon/new-coupon": {
      "post": {
        "summary": "Mint discount coupon",
        "operationId": "createCoupon",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coupon_code": { "type": "string" },
                  "amount": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coupon created"
          }
        }
      }
    }
  }
}
