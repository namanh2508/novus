# Agentic Pentest Platform Environment Configuration
# Copy this file to .env and configure your local settings.
# NEVER commit .env to public version control!

# Target Lab Environment
TARGET_BASE_URL=http://localhost:8888
CRAPI_SPEC_PATH=fixtures/crapi_openapi.json

# Execution & Safety Policies
ALLOWED_HOSTS=localhost,127.0.0.1,localhost:8888
PERMISSION_MODE=interactive # options: strict, interactive, auto-approve
SAFE_MODE=true # enables Shadow Object Cloning for destructive mutations
OPSEC_ANONYMIZATION=true # enables Two-Way HMAC-SHA256 PII/Token masking

# LLM Reasoning Engine (LiteLLM Compatible)
LLM_PROVIDER=openai # options: openai, anthropic, ollama, groq
LLM_MODEL=gpt-4o-mini # or claude-3-5-sonnet-20241022, qwen2.5:32b
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Offline Fallback
FALLBACK_OFFLINE=true # ensures 100% deterministic local heuristic execution if LLM API is unavailable

# Traffic Sniffer & Proxy Settings
PROXY_HOST=127.0.0.1
PROXY_PORT=8080

# Storage & Reporting Paths
SESSION_STORE_PATH=agent_sessions.db
REPORTS_DIR=reports/vault
